# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# Optional: database name (defaults to the one in MONGO_URI, usually "test").
# Use "amora_demo" for the demo data loaded by scripts/importDemoData.js
DB_NAME=

PORT=5000
NODE_ENV=development

# Optional: extra frontend URLs allowed to call the API (comma-separated)
CORS_ORIGINS=

# Optional: Gmail account used to email admin password-reset codes
GMAIL_USER=
GMAIL_APP_PASSWORD=
